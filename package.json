{
  "name": "mesh",
  "version": "0.3.0",
  "private": true,
  "description": "AI workspace OS — desktop app for managing Claude Code projects",
  "author": "Richard Haar",
  "license": "UNLICENSED",
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm rebuild:electron && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "pnpm rebuild:electron && pnpm run build && electron-builder --mac --dir",
    "dist": "pnpm rebuild:electron && pnpm run build && electron-builder --mac",
    "test": "pnpm rebuild:node && vitest run",
    "test:watch": "pnpm rebuild:node && vitest",
    "typecheck": "tsc --noEmit",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3,node-pty",
    "rebuild:node": "pnpm rebuild better-sqlite3 node-pty",
    "postinstall": "electron-rebuild -f -w better-sqlite3,node-pty"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^11.5.0",
    "chokidar": "^5.0.0",
    "ignore": "^7.0.5",
    "lucide-react": "^1.21.0",
    "material-icon-theme": "^5.36.1",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.7",
    "shiki": "^4.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
